OPENAI_API_KEY=
# Leave empty for OpenAI. For OpenRouter: https://openrouter.ai/api/v1
OPENAI_BASE_URL=
MODEL_WRITER=gpt-4o
MODEL_CRITIC=gpt-4o
TTS_MODEL=tts-1
TTS_VOICE=onyx
# OpenRouter TTS (when OPENAI_BASE_URL is set): mistralai/voxtral-mini-tts-2603 + TTS_VOICE=en_paul_neutral
CONF_FLOOR=0.75
COOLDOWN_S=45
GRACE_MS=2500
PAUSE_MS=700

# Convex live share (optional; mirror is a silent no-op when unset)
CONVEX_URL=
# Base for audience share URLs; set to https://thesid42.github.io/voice-draft/watch.html# once Pages is live
AUDIENCE_BASE_URL=
